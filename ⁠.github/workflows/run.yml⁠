name: Run Mobile Agent

on:
  workflow_dispatch: # Позволяет запускать вручную по кнопке

jobs:
  execute:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Run script
        run: python agent.py
